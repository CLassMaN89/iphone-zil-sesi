{
  "name": "iphone-zil-sesi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-ffmpeg-core.mjs",
    "copy:ffmpeg": "node scripts/copy-ffmpeg-core.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
